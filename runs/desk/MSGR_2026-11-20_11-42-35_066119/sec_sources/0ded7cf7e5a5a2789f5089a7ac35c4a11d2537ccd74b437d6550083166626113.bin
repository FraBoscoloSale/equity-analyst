":"Q1","form":"10-Q","filed":"2026-11-06","frame":"CY2026Q3"}]}},"AllowanceForDoubtfulAccountsReceivableCurrent":{"label":"Accounts Receivable, Allowance for Credit Loss, Current","description":"Amount of allowance for credit loss on accounts receivable, classified as current.","units":{"USD":[{"end":"2026-06-30","val":0,"accn":"0001628280-26-071325","fy":2027,"fp":"Q1","form":"10-Q","filed":"2026-11-06","frame":"CY2026Q2I"},{"end":"2026-09-30","val":0,"accn":"0001628280-26-071325","fy":2027,"fp":"Q1","form":"10-Q","filed":"2026-11-06","frame":"CY2026Q3I"}]}},"Assets":{"label":"Assets","description":"Sum of the carrying amounts as of the balance sheet date of all assets that are recognized. Assets are probable future economic benefits obtained or controlled by an entity as a result of past transactions or events.","units":{"USD":[{"end":"2026-06-30","val":517294000,"accn":"0001628280-26-071325","fy":2027,"fp":"Q1","form":"10-Q","filed":"2026-11-06","frame":"CY2026Q2I"},{"end":"2026-09-30","val":601883000,"accn":"0001628280-26-071325","fy":2027,"fp":"Q1","form":"10-Q","filed":"2026-11-06","frame":"CY2026Q3I"}]}},"AssetsCurrent":{"label":"Assets, Current","description":"Sum of the carrying amounts as of the balance sheet date of all assets that are expected to be realized in cash, sold, or consumed within one year (or the normal operating cycle, if longer). Assets are probable future economic benefits obtained or controlled by an entity as a result of past transactions or events.","units":{"USD":[{"end":"2026-06-30","val":68688000,"accn":"0001628280-26-071325","fy":2027,"fp":"Q1","form":"10-Q","filed":"2026-11-06","frame":"CY2026Q2I"},{"end":"2026-09-30","val":118310000,"accn":"0001628280-26-071325","fy":2027,"fp":"Q1","form":"10-Q","filed":"2026-11-06","frame":"CY2026Q3I"}]}},"CapitalExpendituresIncurredButNotYetPaid":{"label":"Capital Expenditures Incurred but Not yet Paid","description":"Future cash outflow to pay for purchases of fixed assets that have occurred.",